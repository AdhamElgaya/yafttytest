# =============================================================================
# Yaftty frontend-only — client environment variables
# Copy to .env.local and fill in values.
# =============================================================================

# Supabase (auth + client reads)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_EMAIL_OTP_LENGTH=6
NEXT_PUBLIC_SKIP_EMAIL_VERIFICATION=false

# Map & OAuth
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Storage mode shown in UI (uploads still need a backend API)
NEXT_PUBLIC_STORAGE_PROVIDER=r2

# Point API calls at your full-stack website/backend when running frontend alone
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Flag for frontend-only tooling
NEXT_PUBLIC_FRONTEND_ONLY=true

# Legacy CRA fallbacks (optional)
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key
REACT_APP_MAPBOX_TOKEN=your-mapbox-token
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id
